generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  tag         String
  location    String
  jobTitle    String
  dateStarted DateTime
  numPosts    Int
  avatar      String
  friends     Int[]
}
